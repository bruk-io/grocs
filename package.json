{
  "name": "grocs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "test": "vitest run --project unit --project ui --project app --project tools",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-grocs 'vitest run --project emulator'",
    "emulators": "node tools/emulators.ts",
    "typecheck": "tsc --noEmit",
    "check": "node tools/checks/run.ts --mode all",
    "check:edit": "node tools/checks/run.ts --mode files",
    "check:release": "node tools/release-bundle.ts",
    "check:demo": "node tools/demo-bundle.ts",
    "tokens": "node tools/build-tokens.ts",
    "svg": "node tools/build-svg.ts",
    "agents:generate": "node tools/agents/generate.ts",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@svgr/plugin-svgo": "8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "fast-check": "^4.0.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.0.0",
    "jsdom": "^26.1.0",
    "lefthook": "^2.0.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
