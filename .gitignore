# Agent worktrees are separate checkouts, not part of this repo
.claude/worktrees/
.claude/settings.local.json
node_modules/
dist/
dist-*/
.expo/
# expo prebuild output (CNG): regenerated from app.config.ts, never committed.
# Not in doc-1's repo layout; also carries google-services.json/GoogleService-Info.plist
# locally, which firebase-isolation forbids anywhere in the tree (R51, R52).
apps/mobile/android/
apps/mobile/ios/
# eas-cli's local working directory (eas env:pull, build:inspect): carries the same
# google-services.json/GoogleService-Info.plist firebase-isolation forbids (R51, R52).
apps/mobile/.eas/
# The GoogleService-Info.plist release.yml's iOS job writes from a GH secret at build time
# (see that workflow's header - EAS's own file env var for this doesn't resolve). Never committed.
apps/mobile/GoogleService-Info.plist
# expo CLI auto-generates this on every prebuild; the repo uses one root tsconfig.json
# (include: apps, packages, tools, firebase) and never had a local one. The generated
# version extends "expo/tsconfig.base", unresolvable from this hoisted layout's module
# resolution, and breaks vitest/typecheck until removed.
apps/mobile/tsconfig.json
storybook-static/
# One PNG per story from `pnpm --filter @grocs/ui shots`
.shots/
*.tsbuildinfo
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
.DS_Store
coverage/

