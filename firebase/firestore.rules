rules_version = '2';

// R4: a member can read and write only their own kitchen's data, enforced here and
// not only in the app. Everything is denied unless a rule below allows it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(kitchenId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/kitchens/$(kitchenId)).data.members;
    }

    // A kitchen is readable by its members. Creating and joining go through
    // server-side functions later (R2, R3); members cannot rewrite the member list here.
    match /kitchens/{kitchenId} {
      allow read: if isMember(kitchenId);
      allow write: if false;

      // Weeks, items, meals and activity all live under the kitchen, in their own subcollections.
      // Requiring one path segment before the recursive wildcard keeps this from also matching
      // kitchens/{kitchenId} itself (a bare {document=**} can match zero segments, which would
      // silently grant the write the rule above just denied).
      match /{collection}/{document=**} {
        allow read, write: if isMember(kitchenId);
      }
    }

    // A returning member's own kitchen, found on any phone after signing in (TASK-14). Written
    // only by the server functions, same as kitchens/{kitchenId} and for the same reason.
    match /memberships/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
