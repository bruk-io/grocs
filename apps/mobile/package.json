{
  "name": "@grocs/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "export": "expo export --platform android --platform ios --output-dir dist",
    "export:release": "NODE_ENV=production expo export --platform android --platform ios --output-dir dist --no-minify"
  },
  "dependencies": {
    "@grocs/application": "workspace:*",
    "@grocs/core": "workspace:*",
    "@grocs/ports": "workspace:*",
    "@grocs/providers-device": "workspace:*",
    "@grocs/providers-firebase": "workspace:*",
    "@grocs/ui": "workspace:*",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "expo": "~58.0.14",
    "expo-constants": "^58.0.12",
    "expo-linking": "^58.0.13",
    "expo-router": "^58.0.23",
    "expo-status-bar": "^58.0.3",
    "react": "19.3.1",
    "react-dom": "^19.3.1",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "react-native-web": "^0.21.4"
  }
}
